{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@packages/frontend-shared": ["packages/frontend-shared/dist/index.d.ts"],
      "@packages/ztan-crypto": ["packages/ztan-crypto/dist/index.d.ts"],
      "@packages/utils": ["packages/utils/dist/index.d.ts"],
      "@packages/contracts": ["packages/contracts/dist/index.d.ts"],
      "@packages/observability": ["packages/observability/dist/index.d.ts"],
      "@packages/config": ["packages/config/dist/index.d.ts"],
      "@packages/business": ["packages/business/dist/index.d.ts"],
      "@packages/auth-internal": ["packages/auth-internal/dist/index.d.ts"],
      "@packages/db": ["packages/db/dist/index.d.ts"],
      "@packages/infra-graph": ["packages/infra-graph/dist/index.d.ts"],
      "@packages/autonomous-ops": ["packages/autonomous-ops/dist/index.d.ts"],
      "@packages/resilience": ["packages/resilience/dist/index.d.ts"],
      "@packages/supabase": ["packages/supabase/dist/index.d.ts"],
      "@packages/operator-compression": ["packages/operator-compression/dist/index.d.ts"],
      "@packages/deployment-hardening": ["packages/deployment-hardening/dist/index.d.ts"],
      "@packages/evidence-lifecycle": ["packages/evidence-lifecycle/dist/index.d.ts"],
      "@packages/institutional-dashboard": ["packages/institutional-dashboard/dist/index.d.ts"]
    }
  }
}
