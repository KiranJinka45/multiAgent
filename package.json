{
  "name": "multiagent-enterprise",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Enterprise-grade Microservices MultiAgent Cluster",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "predev": "echo predev-skip",
    "dev": "tsx scripts/start-dev.ts",
    "clean": "pnpm -r exec node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true,force:true})\"",
    "prebuild": "pnpm run clean",
    "build": "pnpm -r build",
    "start:api": "node apps/api/dist/index.js",
    "start:worker": "node apps/worker/dist/index.js",
    "db:push": "npx prisma db push --schema=packages/db/prisma/schema.prisma --accept-data-loss",
    "db:seed": "echo 'No seed script available'",
    "postinstall": "node scripts/prisma-generate-safe.js --skip-if-exists",
    "test:chaos": "tsx test/integration/chaos-test.ts",
    "test:certify": "tsx test/integration/causal-certification.ts",
    "test:certify:trust": "tsx test/integration/trust-hitl-certification.ts",
    "test:pulse": "tsx test/integration/platform-pulse.ts",
    "test:safety": "tsx test/security/test-safety.ts",
    "test:e2e": "tsx test/integration/e2e-validation.ts",
    "audit:cost": "tsx scripts/audit-cost-roi.ts",
    "orchestrate": "tsx scripts/dev-orchestrator.ts",
    "dev:all": "tsx scripts/dev-orchestrator.ts",
    "validate:cloud": "tsx scripts/validate-cloud.ts"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/middleware-flexible-checksums": "3.974.16",
    "@kubernetes/client-node": "1.0.0",
    "@noble/curves": "1.4.0",
    "@opentelemetry/api": "1.8.0",
    "@prisma/client": "5.22.0",
    "axios": "1.15.2",
    "chalk": "5.6.2",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "commander": "14.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "etcd3": "1.1.2",
    "express": "5.2.1",
    "express-rate-limit": "7.1.5",
    "helmet": "7.1.0",
    "http-proxy-middleware": "3.0.3",
    "jsonwebtoken": "9.0.2",
    "pino": "10.3.1",
    "uuid": "11.0.0"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.0",
      "axios": "1.15.2",
      "zod": "3.23.3",
      "uuid": "11.1.1",
      "next": "15.5.18",
      "undici": "7.2.3",
      "cookie": "1.0.1",
      "path-to-regexp": "8.4.0",
      "form-data": "4.0.4",
      "qs": "6.14.2",
      "postcss": "8.5.10",
      "fast-xml-parser": "5.5.7",
      "tar": "7.5.11",
      "semver": "7.6.3",
      "debug": "4.3.7",
      "elliptic": "6.6.1",
      "http-proxy-middleware": "3.0.5",
      "minimatch": "10.2.5",
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5",
      "@types/express": "5.0.0",
      "@types/express-serve-static-core": "5.0.0",
      "typescript": "5.5.4",
      "@types/node": "20.11.30",
      "express": "5.2.1",
      "fastify": "5.7.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "blake-hash",
      "cpu-features",
      "esbuild",
      "leveldown",
      "lmdb",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "sharp",
      "ssh2"
    ],
    "ignoredBuiltDependencies": [
      "bcrypt"
    ]
  },
  "devDependencies": {
    "@packages/observability": "workspace:*",
    "@packages/utils": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.39",
    "@types/uuid": "10.0.0",
    "jest": "^30.4.2",
    "nock": "14.0.12",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.1.3",
    "prisma": "5.22.0",
    "secure-json-parse": "3.0.2",
    "semver": "7.7.2",
    "ts-jest": "^29.4.9",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "turbo": "2.0.0",
    "typescript": "5.5.4",
    "zod": "3.23.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}