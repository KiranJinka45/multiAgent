{
  "name": "@packages/validator",
  "version": "1.0.0",
  "type": "module",
  "description": "ZTAN Secure Validation Engine with Container Isolation and Safety Guardrails",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "dependencies": {
    "@packages/observability": "workspace:*",
    "@packages/vfs": "workspace:*",
    "@packages/runtime-core": "workspace:*",
    "zod": "3.22.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
