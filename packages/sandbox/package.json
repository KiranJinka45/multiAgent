{
  "name": "@packages/sandbox",
  "version": "1.0.0",
  "dependencies": {
    "@packages/observability": "workspace:*",
    "@packages/sandbox-runtime": "workspace:*",
    "fs-extra": "11.3.4"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.6.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
