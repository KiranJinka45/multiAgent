{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@packages/observability": [
        "../observability/src/index.ts"
      ],
      "@packages/infra-graph": [
        "../infra-graph/src/index.ts"
      ],
      "@packages/db": [
        "../db/src/index.ts"
      ]
    },
    "incremental": true,
    "rootDir": "src"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../utils"
    },
    {
      "path": "../infra-graph"
    }
  ]
}