{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@packages/sre-engine": [
        "../sre-engine/src"
      ],
      "@packages/resilience": [
        "../resilience/src"
      ],
      "@packages/utils": [
        "../utils/src"
      ]
    },
    "incremental": true,
    "rootDir": "src"
  },
  "include": [
    "src*"
  ],
  "references": [
    {
      "path": "../utils"
    }
  ]
}