{
  "name": "@packages/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "stress-test": "tsx src/stress-test.ts",
    "dev": "tsup src/index.ts --no-dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@packages/queue": "workspace:*",
    "@packages/utils": "workspace:*",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsup": "8.5.1",
    "@types/node": "20.19.39"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
