{
  "name": "@packages/contracts",
  "version": "1.0.0",
  "description": "MultiAgent Shared Interface & Protocol Definitions",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts && node -e \"try { require('fs').unlinkSync('tsconfig.tsbuildinfo') } catch (e) {}\" && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format esm --no-dts --watch"
  },
  "dependencies": {
    "zod": "3.22.0"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
