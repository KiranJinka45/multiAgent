datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  name      String?
  role      String        @default("viewer") // admin, agent, viewer
  password  String?
  tenantId  String?
  tenant    Tenant?       @relation(fields: [tenantId], references: [id])
  sessions  UserSession[]
  createdAt DateTime      @default(now())
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  deviceInfo   String?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Tenant {
  id          String    @id @default(uuid())
  name        String
  dailyQuota  Int       @default(10)
  metadata    Json?
  users       User[]
  missions  Mission[]
  agents    Agent[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      String        @default("draft") // draft, active, archived
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  files       ProjectFile[]
  metrics     BuildMetric[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  path      String
  content   String?
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

model Mission {
  id          String   @id @default(uuid())
  title       String
  status      String   @default("idle") // idle, in-progress, completed, failed
  progress    Int      @default(0)
  type        String   @default("exploration")
  description String?
  margin      Float?   @default(0)
  totalCostUsd Float?   @default(0)
  internalOptimizationCost Float? @default(0)
  computeDurationMs Int?   @default(0)
  queueWaitMs Int?         @default(0)
  scalingImpact Float?     @default(0)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  metadata    Json?
  assignedRegion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agent {
  id         String   @id @default(uuid())
  name       String
  type       String // scout, guardian, architect
  status     String   @default("standby") // standby, busy, offline
  health     Int      @default(100)
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  lastActive DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @default("platform-admin")
  userId    String?
  action    String
  resource  String
  metadata  Json?
  status    String?
  ipAddress String?
  hash      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

model ProposedChange {
  id              String   @id @default(uuid())
  agentId         String
  targetPath      String
  changeType      String
  reason          String
  patch           String
  expectedImpact  Json?
  validationScore Float?
  status          String   @default("proposed") // proposed, validated, promoted, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String
  stage       String
  status      String
  message     String?
  progress    Int      @default(0)
  metadata    Json?
  tenantId    String?
  eventId     String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([executionId])
}

model Event {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  tenantId  String?
  metadata  Json?
  eventId   String?  @unique
  createdAt DateTime @default(now())

  @@index([type])
  @@index([tenantId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  tenantId  String?
  stripeId  String?
  productId String?
  plan      String   @default("free")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([stripeId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
}

model ProductMetric {
  id        String   @id @default(uuid())
  productId String
  metric    String
  value     Float
  createdAt DateTime @default(now())

  @@index([productId])
}

model PaymentEvent {
  id        String   @id @default(uuid())
  amount    Float
  currency  String   @default("USD")
  status    String
  createdAt DateTime @default(now())
}

model CodeModule {
  id        String   @id @default(uuid())
  path      String   @unique
  content   String?
  hash      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pattern {
  id          String   @id @default(uuid())
  name        String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model BuildMetric {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  tokensUsed Int      @default(0)
  durationMs Int      @default(0)
  costUsd    Float    @default(0)
  status     String   @default("completed")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model IdempotencyRecord {
  id          String    @id @default(uuid())
  key         String    @unique
  response    Json?
  status      String    @default("completed")
  executionId String?
  region      String?
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IntelligencePolicy {
  id                String   @id @default(uuid())
  name              String   @unique
  tenantId          String?
  isActive          Boolean  @default(true)
  costWeight        Float
  performanceWeight Float
  reliabilityWeight Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IntelligenceROI {
  id               String   @id @default(uuid())
  tenantId         String
  period           String   @default("all-time")
  optimizations    Int      @default(0)
  failureRate      Float    @default(0)
  estimatedSavings Float    @default(0)
  efficiencyGain   Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([id])
  @@index([tenantId])
}

model ZtanLedgerBlock {
  id        Int      @id @default(autoincrement())
  blockId   String   @unique
  prevHash  String
  hash      String
  type      String
  payload   String   // Stores alphabetically normalized JCS string
  operator  String
  signature String   // Base64 NIST P-256 signature
  status    String   // VERIFIED, UNVERIFIED, CONFLICT
  epoch     String
  createdAt DateTime @default(now())

  @@index([epoch])
  @@index([status])
}

model ZtanWalLog {
  id        Int      @id @default(autoincrement())
  seq       Int      @unique
  type      String
  payload   String   // Event payload body
  status    String   // PENDING, COMMITTED
  createdAt DateTime @default(now())

  @@index([seq])
  @@index([status])
}

model ZtanSnapshot {
  id        String   @id @default(uuid())
  epoch     Int      @unique
  lastSeq   Int
  lastHash  String
  stateData String   // JSON-stringified state Representation
  createdAt DateTime @default(now())

  @@index([epoch])
}

model SideEffectRecord {
  id              String   @id @default(uuid())
  idempotencyKey  String
  operationType   String
  status          String   @default("PENDING") // PENDING, COMMITTED, FAILED, RETRYABLE, ABORTED
  attemptNumber   Int      @default(1)
  metadata        Json?
  executionId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([operationType, idempotencyKey])
  @@index([executionId])
}

model ZtanActiveLease {
  id         String   @id @db.VarChar(50)
  generation Int      @default(0)
  owner_pid  Int
  owner_host String   @db.VarChar(255)
  heartbeat  DateTime @default(now())
}

model ZtanPayloadAttestation {
  id                  String   @id @default(uuid())
  blockId             String   @unique
  payloadSanitized    Boolean  @default(true)
  transformations     String   // Stores JSON-serialized array of strings
  originalByteLength  Int
  sanitizedByteLength Int
  sanitizationEpochId String   @default("1")
  createdAt           DateTime @default(now())

  @@index([blockId])
}

model ZtanQuarantineBlob {
  id        String   @id @default(uuid())
  blockId   String   @unique
  rawBlob   String   // Pristine original raw un-sanitized payload
  createdAt DateTime @default(now())

  @@index([blockId])
}

