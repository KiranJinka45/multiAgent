{
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@packages/*": ["../../packages/*/dist/index.d.ts"],
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "noEmit": false,
    "composite": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*"
  ],
  "extends": "../../tsconfig.base.json"
}