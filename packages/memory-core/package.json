{
  "name": "@packages/memory-core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "devDependencies": {
    "bundle-require": "^5.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
