{
  "name": "@packages/memory-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format esm --no-dts --watch"
