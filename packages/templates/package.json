{
  "name": "@packages/templates",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "dependencies": {
    "fs-extra": "11.2.0",
    "path-to-regexp": "6.2.2",
    "@packages/contracts": "workspace:*",
    "@packages/observability": "workspace:*",
    "@packages/core-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsup": "8.5.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
