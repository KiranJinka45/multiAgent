{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@packages/core-engine": [
        "../core-engine/src"
      ],
      "@packages/observability": [
        "../observability/src"
      ],
      "@packages/settlement-layer": [
        "../settlement-layer/src"
      ],
      "@packages/staking-core": [
        "../staking-core/src"
      ],
      "@packages/economics": [
        "../economics/src"
      ],
      "@packages/adversarial-telemetry": [
        "../adversarial-telemetry/src"
      ],
      "@packages/economic-audit": [
        "../economic-audit/src"
      ],
      "@packages/operator-compression": [
        "../operator-compression/src"
      ],
      "@packages/deployment-hardening": [
        "../deployment-hardening/src"
      ],
      "@packages/evidence-lifecycle": [
        "../evidence-lifecycle/src"
      ],
      "@packages/institutional-dashboard": [
        "../institutional-dashboard/src"
      ]
    },
    "rootDir": "src"
  },
  "include": [
    "src/**/*"
  ]
}