{
  "name": "@packages/auth-internal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts && tsc --emitDeclarationOnly -p tsconfig.json --declarationDir ./dist",
    "dev": "tsup src/index.ts --format esm --no-dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "jsonwebtoken": "9.0.2",
    "@packages/config": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.5.4",
    "@types/express": "5.0.0"
  }
}
