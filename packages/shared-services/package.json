{
  "name": "@packages/shared-services",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@packages/utils": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@packages/observability": "workspace:*",
    "ioredis": "5.10.1"
  }
}
