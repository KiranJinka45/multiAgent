{
  "name": "@packages/vfs",
  "version": "1.0.0",
  "description": "ZTAN Virtual File System with Atomic Write and Sandbox Isolation",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "dependencies": {
    "@packages/observability": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
