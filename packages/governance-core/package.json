{
  "name": "@packages/governance-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts && tsc --emitDeclarationOnly -p tsconfig.json --declarationDir ./dist",
    "dev": "tsup src/index.ts --format esm --no-dts --watch",
    "typecheck": "tsc --noEmit",
    "test:verify:external": "tsx scripts/run-validation-harness.ts"
  },
  "dependencies": {
    "zod": "3.23.3",
    "@packages/config": "workspace:*",
    "@packages/utils": "workspace:*",
    "@packages/db": "workspace:*",
    "etcd3": "1.1.2",
    "@temporalio/client": "1.15.0",
    "@temporalio/workflow": "1.15.0",
    "@temporalio/worker": "1.15.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.5.4"
  }
}
