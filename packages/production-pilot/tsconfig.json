{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@packages/observability": [
        "../observability/src/index.ts"
      ],
      "@packages/autonomous-ops": [
        "../autonomous-ops/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../observability"
    },
    {
      "path": "../autonomous-ops"
    }
  ]
}