{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }

  },
  "include": [
    "src/**/*"
  ]
}