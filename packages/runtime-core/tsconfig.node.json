{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "../..",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tsup.config.ts",
    "../../tsup.config.base.ts"
  ]
}

