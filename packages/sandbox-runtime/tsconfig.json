{
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "composite": false,
    "outDir": "dist",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "types": [
      "node"
    ],
    "paths": {
      "@packages/*": ["../../packages/*/dist/index.d.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "extends": "../../tsconfig.base.json"
  
}