{
  "name": "@packages/ztan-crypto",
  "version": "1.0.0",
  "description": "ZTAN Canonical Cryptography (Browser & Node)",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "test:audit": "tsx test/audit.ts",
    "test:bls": "tsx test/bls_test.ts",
    "replay": "tsx scripts/replay.ts",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "dependencies": {
    "@noble/bls12-381": "1.3.0",
    "@noble/hashes": "1.3.0"
  },
  "devDependencies": {
    "fast-check": "4.7.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  }
}
