{
  "name": "@packages/utils",
  "version": "1.0.0",
  "type": "module",
  "description": "MultiAgent Shared Utility Mesh",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --no-dts --watch"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1038.0",
    "@packages/config": "workspace:*",
    "@packages/db": "workspace:*",
    "@packages/observability": "workspace:*",
    "@packages/runtime-core": "workspace:*",
    "@packages/validator": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/uuid": "10.0.0",
    "bullmq": "5.71.0",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "openai": "4.0.0",
    "tailwind-merge": "2.6.1",
    "uuid": "11.0.0",
    "zod": "3.23.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.13.9",
    "tsup": "8.5.1",
    "typescript": "5.5.4"
  }
}
