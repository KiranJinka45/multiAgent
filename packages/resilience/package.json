{
  "name": "@packages/resilience",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --no-dts && tsc --emitDeclarationOnly -p tsconfig.json --declarationDir ./dist",
    "dev": "tsup src/index.ts --format esm --no-dts --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "@packages/observability": "workspace:*",
    "@packages/utils": "workspace:*",
    "axios": "1.15.0",
    "axios-retry": "4.5.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.2",
    "opossum": "8.4.0",
    "rate-limiter-flexible": "5.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "22.13.9",
    "@types/opossum": "8.1.7",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
