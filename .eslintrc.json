{
  "ignorePatterns": ["dist", ".next", "node_modules"],
  "plugins": ["boundaries"],
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "settings": {
    "boundaries/elements": [
      { "type": "app", "pattern": "apps/*" },
      { "type": "lib", "pattern": "packages/*" },
      { "type": "memory-core", "pattern": "packages/memory-core/*" },
      { "type": "memory-vector", "pattern": "packages/memory-vector/*" },
      { "type": "memory-cache", "pattern": "packages/memory-cache/*" },
      { "type": "frontend", "pattern": "apps/frontend/**" },
      { "type": "backend-app", "pattern": "apps/(api|core-api|auth-service|worker|deploy-service|billing-service|gateway|governance)/**" },
      { "type": "shared-lib", "pattern": "packages/frontend-shared/**" },
      { "type": "backend-lib", "pattern": "packages/(?!frontend-shared).**" }
    ]
  },
  "rules": {
    "boundaries/element-types": [2, {
      "default": "allow",
      "message": "${file.type} is not allowed to import ${dependency.type}",
      "rules": [
        {
          "from": "app",
          "disallow": ["app"],
          "message": "Apps cannot import from other apps directly"
        },
        {
          "from": "memory-core",
          "disallow": ["memory-vector", "memory-cache"],
          "message": "Core interfaces cannot depend on implementations (vector/cache)"
        },
        {
          "from": "memory-vector",
          "allow": ["memory-core", "lib"]
        },
        {
          "from": "memory-cache",
          "allow": ["memory-core", "lib"]
        },
        {
          "from": "frontend",
          "disallow": ["backend-app", "backend-lib"],
          "message": "Frontend cannot import from backend apps or backend libraries directly. Use shared-lib instead."
        },
        {
          "from": "shared-lib",
          "disallow": ["backend-app", "backend-lib", "frontend"],
          "message": "Shared libraries must remain pure and cannot depend on apps or backend-only libraries."
        }
      ]
    }],
    "no-restricted-imports": ["error", {
      "patterns": [
        "../../apps/*",
        "../../packages/*",
        "@packages/*/src/*",
        "@packages/*/internal/*"
      ]
    }],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": "warn"
  }
}
