{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@packages/contracts": ["../../packages/contracts/src/index.ts"],
      "@packages/observability": ["../../packages/observability/src/index.ts"],
      "rxjs": ["node_modules/rxjs"],
      "rxjs/*": ["node_modules/rxjs/*"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "../../apps/api",
    "../../apps/core-api",
    "../../apps/worker",
    "../../node_modules",
    ".angular",
    "dist",
    "build"
  ]
}
