{
  "extends": "../../tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "target": "ES2022",
    "jsx": "react-jsx",
    "types": [],
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@packages/contracts": ["../../packages/contracts/src/index.ts"],
      "@packages/observability": ["../../packages/observability/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "../../packages/**/dist",
    "../../packages/**/build",
    "../../packages/**/.turbo",
    "../../packages/**/coverage",
    "../../packages/**/generated",
    "../../packages/**/node_modules",
    "../../packages/db/src/generated",
    "../../apps/api",
    "../../apps/core-api",
    "../../apps/worker",
    "../../node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    ".angular",
    "coverage",
    "dist",
    "build"
  ],
  "references": []
}