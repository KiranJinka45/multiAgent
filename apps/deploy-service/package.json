{
  "name": "@apps/deploy-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup src/index.ts --no-dts && tsc --emitDeclarationOnly -p tsconfig.json --declarationDir ./dist",
    "dev": "tsup src/index.ts --no-dts --watch",
    "start": "node dist/index.js",
    "start:tsx": "tsx -r tsconfig-paths/register src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@packages/contracts": "workspace:*",
    "@packages/db": "workspace:*",
    "@packages/observability": "workspace:*",
    "@packages/utils": "workspace:*",
    "bullmq": "5.71.0",
    "dotenv": "17.4.2",
    "fs-extra": "11.3.4",
    "ioredis": "5.10.1",
    "pino": "10.3.1",
    "vercel": "54.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.13.9",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0"
  }
}