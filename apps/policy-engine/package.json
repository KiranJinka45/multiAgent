{
  "name": "@apps/policy-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup src/index.ts --no-dts --watch",
    "build": "tsup src/index.ts --no-dts && node -e \"try { require('fs').unlinkSync('tsconfig.tsbuildinfo') } catch (e) {}\" && tsc --emitDeclarationOnly -p tsconfig.json --declarationDir ./dist",
    "start": "tsx -r tsconfig-paths/register src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@packages/config": "workspace:*",
    "@packages/observability": "workspace:*",
    "@packages/utils": "workspace:*",
    "@packages/db": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.2",
    "uuid": "11.0.0",
    "zod": "3.23.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.13.9",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1"
  }
}
