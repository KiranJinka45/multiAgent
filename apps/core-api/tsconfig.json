{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "noEmit": false,
    "skipLibCheck": true,
    "paths": {
      "@packages/auth-internal": [
        "../../packages/auth-internal/src/index.ts"
      ],
      "@packages/business": [
        "../../packages/business/src/index.ts"
      ],
      "@packages/db": [
        "../../packages/db/src/index.ts"
      ],
      "@packages/memory": [
        "../../packages/memory/src/index.ts"
      ],
      "@packages/observability": [
        "../../packages/observability/src/index.ts"
      ],
      "@packages/shared-services": [
        "../../packages/shared-services/src/index.ts"
      ],
      "@packages/supabase": [
        "../../packages/supabase/src/index.ts"
      ],
      "@packages/queue": [
        "../../packages/queue/src/index.ts"
      ],
      "@packages/utils": [
        "../../packages/utils/src/index.ts"
      ],
      "@packages/ztan-crypto": [
        "../../packages/ztan-crypto/src/index.ts"
      ],
      "@packages/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    },
    "incremental": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../../packages/auth-internal"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/observability"
    },
    {
      "path": "../../packages/utils"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/ztan-crypto"
    },
    {
      "path": "../../packages/business"
    },
    {
      "path": "../../packages/memory-core"
    },
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/supabase"
    },
    {
      "path": "../../packages/queue"
    }
  ]
}