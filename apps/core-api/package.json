    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@packages/auth-internal": "workspace:*",
    "@packages/business": "workspace:*",
    "@packages/config": "workspace:*",
    "@packages/contracts": "workspace:*",
    "@packages/db": "workspace:*",
