{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "outDir": "dist",
    "composite": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true,
    "paths": {
      "@packages/auth-internal": [
        "../../packages/auth-internal/src"
      ],
      "@packages/billing": [
        "../../packages/billing/src"
      ],
      "@packages/brain": [
        "../../packages/brain/src"
      ],
      "@packages/config": [
        "../../packages/config/src"
      ],
      "@packages/core-engine": [
        "../../packages/core-engine/src"
      ],
      "@packages/db": [
        "../../packages/db/src"
      ],
      "@packages/events": [
        "../../packages/events/src"
      ],
      "@packages/memory-cache": [
        "../../packages/memory-cache/src"
      ],
      "@packages/observability": [
        "../../packages/observability/src"
      ],
      "@packages/resilience": [
        "../../packages/resilience/src"
      ],
      "@packages/utils": [
        "../../packages/utils/src"
      ],
      "@packages/self-evolution": [
        "../../packages/self-evolution/src"
      ]
    },
    "incremental": true,
    "rootDir": "src"
  },
  "include": [
    "src"
  ],
  "references": [
    { "path": "../../packages/auth-internal" },
    { "path": "../../packages/config" },
    { "path": "../../packages/db" },
    { "path": "../../packages/events" },
    { "path": "../../packages/memory-cache" },
    { "path": "../../packages/observability" },
    { "path": "../../packages/resilience" },
    { "path": "../../packages/utils" },
    { "path": "../../packages/ztan-crypto" }
  ]
}