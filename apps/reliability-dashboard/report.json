BACK', resource: 'terraform/aws-us-east', status: 'ROLLED_BACK', timestamp: '14 mins ago', reason: 'Automatic Auto-Recovery' },\r\n    { id: '4', action: 'RECONCILE', resource: 'k8s:default/nginx', status: 'SUCCESS', timestamp: '1 hour ago', reason: 'Drift Repair' },\r\n];\r\n\r\nconst AuditTimeline = () => {\r\n    return (\r\n        <div className=\"glass-panel h-full overflow-hidden flex flex-col\">\r\n            <div className=\"flex justify-between items-center mb-6\">\r\n                <div className=\"flex items-center gap-2\">\r\n                    <History className=\"text-blue-500\" />\r\n                    <h3 className=\"font-semibold uppercase tracking-tight text-sm\">Evidence Timeline</h3>\r\n                </div>\r\n                <span className=\"text-[10px] bg-blue-500/10 text-blue-400 px-2 py-0.5 rounded-full font-bold\">LIVE LEDGER</span>\r\n            </div>\r\n\r\n            <div className=\"space-y-6 overflow-y-auto pr-2 custom-scrollbar\">\r\n                {EVENTS.map((event) => (\r\n                    <div key={event.id} className=\"relative pl-8 border-l border-white/5 pb-2\">\r\n                        <div className=\"absolute -left-[9px] top-0\">\r\n                            {event.status === 'SUCCESS' && <CheckCircle2 size={18} className=\"text-green-500 bg-black rounded-full\" />}\r\n                            {event.status === 'FAILURE' && <XCircle size={18} className=\"text-red-500 bg-black rounded-full\" />}\r\n                            {event.status === 'ROLLED_BACK' && <RotateCcw size={18} className=\"text-amber-500 bg-black rounded-full\" />}\r\n                            {event.status === 'IN_PROGRESS' && <Activity size={18} className=\"text-blue-500 animate-spin bg-black rounded-full\" />}\r\n                        </div>\r\n                        \r\n                        <div className=\"flex flex-col gap-1\">\r\n                            <div className=\"flex justify-between items-center\">\r\n                                <span className=\"text-xs font-mono font-bold text-white/80\">{event.action}</span>\r\n                                <span className=\"text-[10px] text-slate-500\">{event.timestamp}</span>\r\n                            </div>\r\n                            <div className=\"text-[11px] text-blue-400 font-mono\">{event.resource}</div>\r\n                            <div className=\"text-[11px] text-slate-500 mt-1 italic\">\"{event.reason}\"</div>\r\n                        </div>\r\n                    </div>\r\n                ))}\r\n            </div>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default AuditTimeline;\r\n","usedDeprecatedRules":[]},{"filePath":"c:\\multiagentic_project\\multiAgent-main\\apps\\reliability-dashboard\\src\\components\\InfraGraph.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"c:\\multiagentic_project\\multiAgent-main\\apps\\reliability-dashboard\\src\\main.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"c:\\multiagentic_project\\multiAgent-main\\apps\\reliability-dashboard\\vite.config.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"c:\\multiagentic_project\\multiAgent-main\\apps\\reliability-dashboard\\vite.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]