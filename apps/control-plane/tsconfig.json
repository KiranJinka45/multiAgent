    "outDir": "dist",
    "rootDir": "src",
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "paths": {
      "@packages/*": ["../../packages/*/dist/index.d.ts"],
      "@/*": ["./src/*"]
